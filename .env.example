# このファイルを .env という名前でコピーして、中身を書き換えてください。
#   Windows:  copy .env.example .env
# .env はパスワードが入るので GitHub には上げません（.gitignore に入っています）。
#
# DB には SSH トンネル経由でつなぎます。
# 別のターミナルで次のコマンドを開いたままにしておくと、
# 「自分のPCの 13306 番」がサーバの MySQL につながります。
#   ssh -i ~\.ssh\potchi_key -N -L 13306:127.0.0.1:3306 student@サーバIP

DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=student
DB_PASSWORD=MySQLのパスワード
DB_NAME=potchi
SECRET_KEY=好きな英数字を20文字くらい
